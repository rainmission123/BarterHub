rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /id_verifications/{uid}/{side}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && (side == "front" || side == "back")
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /profile_pictures/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /profile_pictures/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    match /chat_images/{chatId}/{memberA}/{memberB}/{uploaderUid}/{fileName} {
      allow read: if request.auth != null
        && (request.auth.uid == memberA || request.auth.uid == memberB);
      allow write: if request.auth != null
        && request.auth.uid == uploaderUid
        && (request.auth.uid == memberA || request.auth.uid == memberB)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /chat_images/{chatId}/{fileName} {
      allow read, write: if false;
    }

    match /chat_media/{chatId}/images/{uploaderUid}/{fileName} {
      allow read, write: if false;
    }

    match /chat_media/{chatId}/images/{memberA}/{memberB}/{uploaderUid}/{fileName} {
      allow read: if request.auth != null
        && (request.auth.uid == memberA || request.auth.uid == memberB);

      allow create, update: if request.auth != null
        && request.auth.uid == uploaderUid
        && (uploaderUid == memberA || uploaderUid == memberB)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null
        && request.auth.uid == uploaderUid;
    }

    match /chat_media/{chatId}/videos/{uploaderUid}/{fileName} {
      allow read, write: if false;
    }

    match /chat_media/{chatId}/videos/{memberA}/{memberB}/{uploaderUid}/{fileName} {
      allow read: if request.auth != null
        && (request.auth.uid == memberA || request.auth.uid == memberB);

      allow create, update: if request.auth != null
        && request.auth.uid == uploaderUid
        && (uploaderUid == memberA || uploaderUid == memberB)
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');

      allow delete: if request.auth != null
        && request.auth.uid == uploaderUid;
    }

    match /item_images/{uid}/{itemId}/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
