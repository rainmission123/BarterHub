<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll_how_to_earn"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_home_profile_logo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/form_screen_horizontal_padding"
        android:paddingTop="20dp"
        android:paddingEnd="@dimen/form_screen_horizontal_padding"
        android:paddingBottom="20dp">

        <!-- Header with Icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp"
            tools:ignore="UseCompoundDrawables">

            <TextView
                android:id="@+id/tvHowToEarnHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/how_to_earn_on_barterhub"
                android:textSize="24sp"
                android:textStyle="bold|italic"
                android:textColor="@color/white" />

        </LinearLayout>

        <!-- Games Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardGames"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            android:background="?attr/colorSurface"
            app:cardElevation="4dp"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/colorSurface"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/playingcards"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvGamesTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/games"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/tvGamesDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/play_fun_games_and_earn_rewards"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp" />

                    <!-- Action Button for Games -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenGames"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/play_games"
                        android:textColor="@color/White"
                        android:textSize="12sp"
                        app:backgroundTint="@color/bh_primary"
                        app:cornerRadius="8dp" />

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


        <!-- Referral System Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardReferral"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/colorSurface"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/referral"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/_1_referral_system"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/tvReferralDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/invite_friends_when_they_sign_up_and_complete_their_first_transaction_you_earn_referral_coins_encourages_community_growth"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp"
                        tools:ignore="VisualLintLongText" />

                    <!-- Action Button for Referral -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnInviteFriends"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/invite_friends"
                        android:textColor="@color/White"
                        android:textSize="12sp"
                        app:backgroundTint="@color/bh_primary"
                        app:cornerRadius="8dp" />

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Selling & Transactions Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSelling"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/colorSurface"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/deal"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSellTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/_2_selling_amp_transactions"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/tvSellDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/post_items_for_sale_or_barter_you_earn_coins_when_posting"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp" />

                    <!-- Action Button for Selling -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPostItem"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/post_item"
                        android:textColor="@color/White"
                        android:textSize="12sp"
                        app:backgroundTint="@color/bh_primary"
                        app:cornerRadius="8dp" />

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Daily Challenges Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardChallenges"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/colorSurface"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/reach"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDailyTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/_3_daily_challenges"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/tvDailyIntro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/complete_small_tasks_every_day_to_earn_extra_coins"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp" />

                    <!-- List of example challenges -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:id="@+id/tvChallenge1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/post_1_item_5_coins"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/tvChallenge2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/complete_2_transactions_10_coins"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/tvChallenge3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/daily_login_2_coins"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Action Button for Challenges -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnViewChallenges"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/view_challenges"
                        android:textColor="@color/White"
                        android:textSize="12sp"
                        app:backgroundTint="@color/bh_primary"
                        app:cornerRadius="8dp" />

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Go Back Button Only -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoBack"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/go_back"
            android:textColor="?attr/colorOnSurface"
            app:strokeColor="?attr/colorOnSurface"
            app:cornerRadius="8dp" />

    </LinearLayout>
</ScrollView>
