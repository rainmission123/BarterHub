<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_margin="10dp"
    android:padding="10dp"
    android:background="?attr/colorSurface"
    android:clickable="true"
    android:focusable="true">

    <!-- Profile Picture -->
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/ivProfilePicture"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="12dp"
        android:src="@drawable/ic_profile_placeholder"
        app:civ_border_width="1dp"
        app:civ_border_color="?attr/colorOutline"
        tools:ignore="ContentDescription" />

    <!-- Notification Content -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Notification Message -->
        <TextView
            android:id="@+id/tvNotificationMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Notification message"
            android:textSize="16sp"
            android:textColor="?attr/colorOnSurface"
            tools:ignore="HardcodedText" />

        <!-- Time Indicator -->
        <TextView
            android:id="@+id/tvNotificationTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/just_now"
            android:textSize="12sp"
            android:textColor="?attr/postTextColor"
            android:layout_marginTop="4dp" />


    </LinearLayout>

    <!-- Like Icon for Like Notifications -->
    <ImageView
        android:id="@+id/ivNotificationIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_favorite_filled"
        android:visibility="visible"
        app:tint="@color/gray_600"
        tools:ignore="ContentDescription" />

    <!-- Delete Notification Icon -->
    <ImageView
        android:id="@+id/ivDeleteNotification"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_remove"
        android:contentDescription="Delete Notification"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless" />

</LinearLayout>
