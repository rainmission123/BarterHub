<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="192dp"
    android:gravity="bottom"
    android:padding="20dp"
    android:background="@color/colorAccent"
    android:theme="@style/ThemeOverlay.AppCompat.Dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/userProfileSection"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_profile"
            app:civ_border_width="2dp"
            android:elevation="8dp"
            android:contentDescription="@string/profile_image_description" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/userName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/user_name_default"
                android:textColor="?attr/postTextColor"
                android:textSize="18sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/userEmail"
                android:layout_width="252dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/user_email_com"
                android:textColor="?attr/postTextColor"
                android:textSize="14sp" />

            <View
                android:layout_width="wrap_content"
                android:layout_height="2dp"
                android:background="?attr/postTextColor"
                android:layout_marginTop="8dp"
                android:alpha="0.8" />

        </LinearLayout>

        <ImageView
            android:id="@+id/verifiedBadge"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/verified_badge_description"
            android:src="@drawable/ic_badge_verified"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Status/Online Indicator -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp">

        <View
            android:id="@+id/onlineStatus"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/online_indicator"
            android:elevation="2dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/online"
            android:textColor="?attr/postTextColor"
            android:textSize="12sp"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</LinearLayout>