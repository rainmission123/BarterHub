<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="192dp"
    android:background="@drawable/bg_home_profile_logo"
    android:padding="20dp"
    android:theme="@style/ThemeOverlay.AppCompat.Dark">

    <ImageView
        android:id="@+id/btnCloseDrawer"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="top|end"
        android:src="@drawable/ic_close"
        app:tint="@color/White"
        android:clickable="true"
        android:focusable="true"
        android:padding="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Close menu"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/_60dp"
        android:gravity="bottom">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/userProfileSection"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_profile"
            app:civ_border_width="2dp"
            android:elevation="8dp"
            android:contentDescription="@string/profile_image_description" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/userName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/user_name_default"
                android:textColor="@color/White"
                android:textSize="18sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/userEmail"
                android:layout_width="252dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/user_email_com"
                android:textColor="@color/White"
                android:textSize="14sp" />

            <View
                android:layout_width="wrap_content"
                android:layout_height="2dp"
                android:background="@color/White"
                android:layout_marginTop="8dp"
                android:alpha="0.8" />

        </LinearLayout>

        <ImageView
            android:id="@+id/verifiedBadge"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/verified_badge_description"
            android:visibility="gone" />

    </LinearLayout>


</FrameLayout>