<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/receiptScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fillViewport="true"
    android:padding="52dp">

    <LinearLayout
        android:id="@+id/receiptRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="4dp"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:padding="20dp"
        android:paddingBottom="24dp">

        <!-- 🧾 RECEIPT HEADER with torn paper effect -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <!-- BarterHub Logo/Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/barterhub"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:letterSpacing="0.1"
                android:fontFamily="monospace"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TRANSACTION RECEIPT"
                android:textSize="14sp"
                android:textColor="@color/dark_gray"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="4dp"/>

            <!-- Dashed line separator -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/dashed_line"
                android:layout_marginVertical="12dp"/>
        </LinearLayout>

        <!-- 📋 RECEIPT INFO SECTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:weightSum="2">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/receipt_no"
                    android:textSize="12sp"
                    android:textColor="@color/dark_gray"
                    android:fontFamily="monospace"/>

                <TextView
                    android:id="@+id/tvReceiptId"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/rcpt_2024_001"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="end"
                    android:fontFamily="monospace"
                    tools:text="RCPT-2024-001"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/light_gray"
                android:layout_marginVertical="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:weightSum="2">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="DATE"
                    android:textSize="12sp"
                    android:textColor="@color/dark_gray"
                    android:fontFamily="monospace"/>

                <TextView
                    android:id="@+id/tvReceiptDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/mar_15_2024_14_30"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="end"
                    android:fontFamily="monospace"
                    tools:text="Mar 15, 2024 - 14:30"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Dashed separator -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/dashed_line"
            android:layout_marginVertical="12dp"/>

        <!-- 👥 TRADERS SECTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/traders"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:fontFamily="sans-serif-medium"
                android:paddingBottom="8dp"/>

            <!-- Trader A -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="6dp">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="@string/a"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/dark_gray"/>


                <TextView
                    android:id="@+id/tvUserA"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/john_doe"
                    android:textColor="@color/gray_500"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="john_doe"/>
            </LinearLayout>

            <!-- Trader B -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="6dp">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="@string/b"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/dark_gray"/>


                <TextView
                    android:id="@+id/tvUserB"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/jane_smith"
                    android:textColor="@color/gray_500"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="jane_smith"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Dashed separator -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/dashed_line"
            android:layout_marginVertical="12dp"/>

        <!-- 📦 ITEMS SECTION - PARANG GROCERY RECEIPT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/items_exchanged"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:fontFamily="sans-serif-medium"
                android:paddingBottom="8dp"/>

            <!-- Table Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="4dp"
                android:background="@color/gray_50">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="@string/item"
                    android:textSize="11sp"
                    android:textColor="@color/gray_500"
                    android:textStyle="bold"
                    android:paddingStart="4dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/from"
                    android:textSize="11sp"
                    android:textColor="@color/gray_500"
                    android:textStyle="bold"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/to"
                    android:textColor="@color/gray_500"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/cond"
                    android:textSize="11sp"
                    android:textColor="@color/gray_500"
                    android:textStyle="bold"
                    android:gravity="end"
                    android:paddingEnd="4dp"/>
            </LinearLayout>

            <!-- Offered Item Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="8dp"
                android:background="@drawable/receipt_row_border">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="4dp">


                    <TextView
                        android:id="@+id/tvOfferedItem"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/gaming_mouse"
                        android:textSize="12sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        tools:text="Gaming Mouse"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvOfferedFrom"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="User A"
                    android:textSize="12sp"
                    android:gravity="center"
                    tools:text="A"/>

                <TextView
                    android:id="@+id/tvOfferedTo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="User B"
                    android:textSize="12sp"
                    android:gravity="center"
                    tools:text="B"/>

                <TextView
                    android:id="@+id/tvOfferedCondition"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/like_new"
                    android:textSize="12sp"
                    android:gravity="end"
                    android:paddingEnd="4dp"
                    tools:text="Like New"/>
            </LinearLayout>

            <!-- Target Item Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="8dp"
                android:background="@drawable/receipt_row_border">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="4dp">

                    <TextView
                        android:id="@+id/tvTargetItem"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mechanical_keyboard"
                        android:textSize="12sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        tools:text="Mechanical Keyboard"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTargetFrom"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="User B"
                    android:textSize="12sp"
                    android:gravity="center"
                    tools:text="B"/>

                <TextView
                    android:id="@+id/tvTargetTo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="User A"
                    android:textSize="12sp"
                    android:gravity="center"
                    tools:text="A"/>

                <TextView
                    android:id="@+id/tvTargetCondition"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/good"
                    android:textSize="12sp"
                    android:gravity="end"
                    android:paddingEnd="4dp"
                    tools:text="Good"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Dashed separator -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/dashed_line"
            android:layout_marginVertical="12dp"/>

        <!-- 📊 TRANSACTION SUMMARY -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:weightSum="2"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Transaction Status:"
                    android:textSize="13sp"
                    android:textColor="@color/dark_gray"/>

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="COMPLETED"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="end"
                    android:textColor="@color/teal_700"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/light_gray"
                android:layout_marginVertical="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:weightSum="2">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Chat ID:"
                    android:textSize="11sp"
                    android:textColor="@color/dark_gray"
                    android:fontFamily="monospace"/>

                <TextView
                    android:id="@+id/tvChatId"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="CHT-12345"
                    android:textSize="11sp"
                    android:gravity="end"
                    android:fontFamily="monospace"
                    android:alpha="0.8"
                    tools:text="CHT-12345"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:weightSum="2"
                android:paddingTop="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Request ID:"
                    android:textSize="11sp"
                    android:textColor="@color/dark_gray"
                    android:fontFamily="monospace"/>

                <TextView
                    android:id="@+id/tvRequestId"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="REQ-12345"
                    android:textSize="11sp"
                    android:gravity="end"
                    android:fontFamily="monospace"
                    android:alpha="0.8"
                    tools:text="REQ-12345"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Tear-off bottom part -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/dashed_line"
            android:layout_marginVertical="16dp"/>

        <!-- Footer Note -->
        <TextView
            android:id="@+id/tvFooterNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✓ This serves as official proof of barter transaction"
            android:textSize="12sp"
            android:textColor="@color/dark_gray"
            android:gravity="center"
            android:fontFamily="sans-serif-light"
            android:paddingBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BarterHub Philippines • Keep this receipt"
            android:textSize="10sp"
            android:textColor="@color/medium_gray"
            android:gravity="center"
            android:fontFamily="monospace"/>

    </LinearLayout>
</ScrollView>