<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Image Gallery with Horizontal Scroll -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="260dp"
            app:cardCornerRadius="1dp"
            app:cardElevation="1dp"
            android:layout_marginBottom="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- Horizontal ScrollView for Images -->
                <HorizontalScrollView
                    android:id="@+id/horizontalScrollView"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:scrollbars="none"
                    android:fadingEdgeLength="50dp"
                    android:overScrollMode="never">

                    <LinearLayout
                        android:id="@+id/imageContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:padding="1dp">

                        <!-- Default/First Image -->
                        <ImageView
                            android:id="@+id/itemImage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:background="@color/gray_light"
                            android:contentDescription="@string/item_image"
                            android:layout_margin="0dp"
                            tools:src="@tools:sample/backgrounds/scenic" />

                        <!-- Additional images will be added programmatically -->
                        <!-- Sample additional images for preview -->
                        <ImageView
                            android:layout_width="320dp"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:background="@color/gray_light"
                            android:contentDescription="@string/item_image"
                            android:layout_margin="0dp"
                            tools:src="@tools:sample/backgrounds/scenic" />

                        <ImageView
                            android:layout_width="320dp"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:background="@color/gray_light"
                            android:contentDescription="@string/item_image"
                            android:layout_margin="0dp"
                            tools:src="@tools:sample/backgrounds/scenic" />

                        <ImageView
                            android:layout_width="320dp"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:background="@color/gray_light"
                            android:contentDescription="@string/item_image"
                            android:layout_margin="0dp"
                            tools:src="@tools:sample/backgrounds/scenic" />

                        <ImageView
                            android:layout_width="320dp"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:background="@color/gray_light"
                            android:contentDescription="@string/item_image"
                            android:layout_margin="0dp"
                            tools:src="@tools:sample/backgrounds/scenic" />

                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Image Indicator Dots -->
                <LinearLayout
                    android:id="@+id/imageIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:background="@color/white"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:padding="1dp">

                    <!-- Dots will be added programmatically -->
                    <ImageView
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:background="@drawable/indicator_dot_active"
                        android:layout_margin="4dp" />

                    <ImageView
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:background="@drawable/indicator_dot_inactive"
                        android:layout_margin="4dp" />

                    <ImageView
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:background="@drawable/indicator_dot_inactive"
                        android:layout_margin="4dp" />

                    <ImageView
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:background="@drawable/indicator_dot_inactive"
                        android:layout_margin="4dp" />

                    <ImageView
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:background="@drawable/indicator_dot_inactive"
                        android:layout_margin="4dp" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Title -->
        <TextView
            android:id="@+id/itemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sample_item_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:lineSpacingExtra="4sp"
            android:layout_marginBottom="8dp" />

        <!-- Price -->
        <TextView
            android:id="@+id/itemPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sample_price"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/teal_700"
            android:background="@drawable/price_background"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:layout_marginBottom="12dp" />

        <!-- Category Chip -->
        <com.google.android.material.chip.Chip
            android:id="@+id/itemCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sample_category"
            app:chipBackgroundColor="@color/teal_100"
            android:textColor="@color/teal_800"
            app:chipStrokeColor="@color/teal_300"
            app:chipStrokeWidth="1dp"
            android:layout_marginBottom="16dp" />

        <!-- Description Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/description"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/itemDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sample_description"
            android:textSize="16sp"
            android:textColor="@color/gray_dark"
            android:lineSpacingExtra="6sp"
            android:layout_marginBottom="24dp" />

        <!-- Owner Info Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/owner_information"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <ImageView
                android:id="@+id/ownerImage"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/todo"
                android:scaleType="centerCrop"
                android:background="@drawable/circle_background"
                android:src="@drawable/ic_profile"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/itemOwner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sample_owner_name"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/black" />

                <!-- Rating with separate ImageView -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp"
                    tools:ignore="UseCompoundDrawables">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@string/todo"
                        android:src="@drawable/ic_rate_star"
                        app:tint="@color/gray_dark" />

                    <TextView
                        android:id="@+id/ownerRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sample_rating"
                        android:textSize="14sp"
                        android:textColor="@color/gray_dark"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/postedDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/date_background"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="@string/sample_date"
                android:textColor="#757575"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Location Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Location"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12px"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/todo"
                android:src="@drawable/ic_location"
                android:layout_marginEnd="8dp"
                app:tint="@color/gray_dark" />

            <TextView
                android:id="@+id/itemLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sample_location"
                android:textSize="14sp"
                android:textColor="@color/gray_dark" />

        </LinearLayout>

        <!-- 🗺️ MAP SECTION -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="200dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            android:layout_marginBottom="24dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Google Map Fragment -->
                <androidx.fragment.app.FragmentContainerView
                    android:id="@+id/mapView"
                    android:name="com.google.android.gms.maps.SupportMapFragment"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Map Loading Indicator -->
                <ProgressBar
                    android:id="@+id/mapLoading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="visible" />

                <!-- Open in Maps Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenMaps"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_gravity="top"
                    android:layout_margin="5dp"
                    android:text="@string/open_in_maps"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:visibility="gone"
                    app:icon="@drawable/ic_navigation"
                    app:iconGravity="textStart"
                    app:backgroundTint="@color/success"
                    app:iconSize="16dp"
                    app:iconTint="@null"
                    tools:ignore="SmallSp" />

            </FrameLayout>

        </androidx.cardview.widget.CardView>


        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLike"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/like"
                android:textAllCaps="false"
                app:icon="@drawable/ic_favorite_border"
                app:iconGravity="textStart"
                app:strokeColor="@color/teal_700"
                app:iconTint="@color/teal_700" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChat"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:layout_weight="2"
                android:text="@string/chat_owner"
                android:textAllCaps="false"
                android:textColor="#000000"
                app:backgroundTint="@color/teal_700"
                app:icon="@drawable/ic_chat"
                app:iconGravity="textStart" />

        </LinearLayout>

        <!-- Make Offer Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMakeOffer"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/make_offer"
            android:textAllCaps="false"
            android:layout_marginTop="8dp"
            style="@style/Widget.Material3.Button.TonalButton"
            app:backgroundTint="@color/gray_200"
            app:strokeColor="@color/teal_300"
            app:icon="@drawable/ic_offer"
            android:textColor="@color/gray_800"
            app:iconTint="@color/gray_700"
            app:iconGravity="textStart" />

        <!-- Request Trade Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRequestBarter"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/request_trade"
            android:textAllCaps="false"
            android:layout_marginTop="8dp"
            style="@style/Widget.Material3.Button"
            app:backgroundTint="@color/teal_700"
            android:textColor="@android:color/white"
            app:icon="@drawable/ic_trade"
            app:iconTint="@android:color/white"
            app:iconGravity="textStart" />


    </LinearLayout>
</ScrollView>