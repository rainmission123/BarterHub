<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/backgroundlogin"
    tools:context=".ui.AddPreviewFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="10dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_60dp"
            android:orientation="vertical">

            <!-- Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/preview_your_listing"
                android:textColor="@color/White"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/make_sure_everything_looks_right_before_listing_your_item"
                android:textColor="@color/White"
                android:textSize="14sp"
                android:layout_marginBottom="20dp" />

            <!-- Photo Carousel -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/photoPreviewRecycler"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="?attr/colorSurface"
                android:layout_marginBottom="24dp"
                android:clipToPadding="false"
                android:paddingEnd="8dp"
                tools:ignore="RtlSymmetry,SpeakableTextPresentCheck"
                tools:listitem="@layout/item_photo_preview" />

            <!-- Info Cards -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:divider="?android:attr/dividerHorizontal"
                android:showDividers="middle"
                android:dividerPadding="12dp">

                <!-- Title -->
                <TextView
                    android:id="@+id/previewTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sample_title"
                    android:textColor="@color/White"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <!-- Description -->
                <TextView
                    android:id="@+id/previewDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sample_description_of_the_item_being_listed_for_barter"
                    android:textColor="@color/White"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <!-- Category / Condition -->
                <TextView
                    android:id="@+id/previewCategoryCondition"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/electronics_like_new"
                    android:textColor="@color/White"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <!-- Price Container -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <!-- Original Price (with strikethrough) -->
                    <TextView
                        android:id="@+id/previewOriginalPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₱2,000"
                        android:textColor="@color/gray_500"
                        android:textSize="14sp"
                        android:visibility="gone"
                        android:layout_marginEnd="8dp" />

                    <!-- Current Price -->
                    <TextView
                        android:id="@+id/previewPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/_1_500"
                        android:textColor="@color/netflix_red"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:ignore="TextContrastCheck" />

                </LinearLayout>

                <!-- Location -->
                <TextView
                    android:id="@+id/previewLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Manila, Philippines"
                    android:textColor="@color/White"
                    android:textSize="14sp"
                    android:drawablePadding="6dp"
                    tools:ignore="HardcodedText,MissingPrefix" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- List Now Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/listNowButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:text="@string/list_now"
        android:textAllCaps="false"
        android:textSize="16sp"
        app:backgroundTint="@color/com_facebook_messenger_blue"
        app:cornerRadius="16dp"
        app:icon="@drawable/ic_list"
        app:iconGravity="end"
        tools:ignore="TextContrastCheck" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>