<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_background"
    android:elevation="8dp">

    <!-- Header -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="React to Message"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:textStyle="bold"
        android:padding="16dp"
        android:background="@color/colorPrimaryLight" />

    <!-- Quick Reactions Row -->
    <LinearLayout
        android:id="@+id/quickReactionsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="12dp"
        android:background="@color/white">

        <TextView
            android:id="@+id/emojiLike"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            android:gravity="center"
            android:text="👍"
            android:textSize="24sp"
            android:background="@drawable/emoji_background"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/emojiLove"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            android:gravity="center"
            android:text="❤️"
            android:textSize="24sp"
            android:background="@drawable/emoji_background"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/emojiHaha"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            android:gravity="center"
            android:text="😂"
            android:textSize="24sp"
            android:background="@drawable/emoji_background"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/emojiWow"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            android:gravity="center"
            android:text="😮"
            android:textSize="24sp"
            android:background="@drawable/emoji_background"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/emojiSad"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            android:gravity="center"
            android:text="😢"
            android:textSize="24sp"
            android:background="@drawable/emoji_background"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/emojiAngry"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            android:gravity="center"
            android:text="😠"
            android:textSize="24sp"
            android:background="@drawable/emoji_background"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gray_300" />

    <!-- Tab Layout for Categories -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabMode="scrollable"
        app:tabTextColor="@color/gray_600"
        app:tabSelectedTextColor="@color/colorPrimary"
        app:tabIndicatorColor="@color/colorPrimary"
        android:background="@color/white" />

    <!-- Emoji Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvEmojis"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:padding="8dp"
        android:clipToPadding="false"
        android:background="@color/white" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gray_300"/>

    <!-- Message Actions -->
    <LinearLayout
        android:id="@+id/messageActionsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/white"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/btnCopyMessage"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:text="📋 Copy Message"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:textColor="@android:color/black"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnDeleteMessage"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:text="🗑 Delete for me"
            android:textColor="#D32F2F"
            android:textSize="15sp" />

    </LinearLayout>

    <!-- Close Button -->
    <Button
        android:id="@+id/btnClose"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Cancel"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:background="@color/colorPrimary"
        android:layout_margin="8dp"
        android:elevation="2dp" />

</LinearLayout>