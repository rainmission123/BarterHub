<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ✅ PROFESSIONAL IMAGE GALLERY - NOW PART OF SCROLL -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="280dp"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/colorSurface">

            <androidx.coordinatorlayout.widget.CoordinatorLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Image Count Badge -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    android:layout_gravity="top|end"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#80000000">

                    <TextView
                        android:id="@+id/tvImageCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:text="1/5"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </com.google.android.material.card.MaterialCardView>

                <!-- Horizontal ScrollView for Images -->
                <HorizontalScrollView
                    android:id="@+id/horizontalScrollView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fadingEdgeLength="0dp"
                    android:fillViewport="true"
                    android:overScrollMode="never"
                    android:scrollbars="none"
                    tools:ignore="SpeakableTextPresentCheck">

                    <LinearLayout
                        android:id="@+id/imageContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp">

                        <ImageView
                            android:id="@+id/itemImage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@color/gray_light"
                            android:contentDescription="@string/item_image"
                            android:scaleType="centerCrop"
                            android:visibility="gone"
                            tools:src="@tools:sample/backgrounds/scenic" />

                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Professional Image Indicator -->
                <LinearLayout
                    android:id="@+id/imageIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp">
                </LinearLayout>

            </androidx.coordinatorlayout.widget.CoordinatorLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ✅ CONTENT - NOW PART OF SAME SCROLL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- Title -->
            <TextView
                android:id="@+id/itemTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sample_item_title"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:lineSpacingExtra="4sp"
                android:layout_marginBottom="8dp" />

            <!-- Price -->
            <TextView
                android:id="@+id/itemPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sample_price"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/teal_700"
                android:background="@drawable/price_background"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:layout_marginBottom="12dp" />

            <!-- Category Chip -->
            <com.google.android.material.chip.Chip
                android:id="@+id/itemCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sample_category"
                app:chipBackgroundColor="@color/teal_100"
                android:textColor="@color/teal_800"
                app:chipStrokeColor="@color/teal_300"
                app:chipStrokeWidth="1dp"
                android:layout_marginBottom="16dp" />

            <!-- Description Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/description"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="8dp" />

            <!-- Description with View More functionality -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/itemDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sample_description"
                    android:textSize="16sp"
                    android:textColor="?attr/colorOnSurface"
                    android:lineSpacingExtra="6sp"
                    android:maxLines="3"
                    android:ellipsize="end" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewMore"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:text="View More"
                    android:textColor="?attr/colorPrimary"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Owner Info Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/owner_information"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:id="@+id/ownerInfoSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:id="@+id/ownerImage"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/todo"
                    android:scaleType="centerCrop"
                    android:background="@drawable/circle_background"
                    android:src="@drawable/ic_profile"
                    android:layout_marginEnd="12dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/itemOwner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sample_owner_name"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface" />

                    <!-- Rating with separate ImageView -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="2dp"
                        tools:ignore="UseCompoundDrawables">

                        <ImageView
                            android:id="@+id/starIcon"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@string/todo"
                            android:src="@drawable/ic_rate_star"
                            app:tint="@color/gray_dark" />

                        <TextView
                            android:id="@+id/ownerRating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sample_rating"
                            android:textSize="14sp"
                            android:textColor="?attr/colorOnSurface"
                            android:layout_marginStart="4dp" />
                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/postedDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/date_background"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text="@string/sample_date"
                    android:textColor="#616161"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Location Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Location"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="8dp"
                tools:ignore="HardcodedText" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/todo"
                    android:src="@drawable/ic_location"
                    android:layout_marginEnd="8dp"
                    app:tint="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/itemLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sample_location"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>

            <!-- Mapbox Map - NOW CLICKABLE -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/mapCardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                tools:ignore="SpeakableTextPresentCheck">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.mapbox.maps.MapView
                        android:id="@+id/mapViewItemDetail"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        app:mapbox_cameraTargetLat="14.5995"
                        app:mapbox_cameraTargetLng="120.9842"
                        app:mapbox_cameraZoom="15"
                        tools:ignore="MissingConstraints" />

                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLike"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="@string/like"
                    android:textColor="?attr/colorOnSurface"
                    android:textAllCaps="false"
                    app:icon="@drawable/ic_favorite_border"
                    app:iconGravity="textStart"
                    app:strokeColor="@color/teal_700"
                    app:iconTint="@null" />


                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChat"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="2"
                    android:text="@string/chat_owner"
                    android:textAllCaps="false"
                    android:textColor="#000000"
                    app:backgroundTint="@color/teal_700"
                    app:icon="@drawable/ic_chat"
                    app:iconGravity="textStart"
                    app:iconTint="@null" />

            </LinearLayout>

            <!-- Request Trade Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRequestBarter"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="@string/request_trade"
                android:textAllCaps="false"
                android:textColor="?attr/colorOnSurface"
                app:backgroundTint="@color/teal_700"
                app:icon="@drawable/ic_trade"
                app:iconGravity="textStart"
                app:iconTint="@android:color/white" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>