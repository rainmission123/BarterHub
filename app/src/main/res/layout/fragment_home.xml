<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/rootLayout">

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <!-- Wishlist Icon -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp">

                <ImageView
                    android:id="@+id/itemWishlistIcon"
                    android:layout_width="30dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_heart"
                    app:tint="@color/white"/>
            </FrameLayout>

            <!-- Search Bar -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/rounded_corner"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="7dp">

                <ImageView
                    android:id="@+id/searchIcon"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_search"
                    app:tint="@color/gray_500"/>

                <EditText
                    android:id="@+id/searchInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="@string/search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:textColor="@color/gray_700"
                    android:textColorHint="#616161"
                    android:textSize="14sp"
                    tools:ignore="TouchTargetSizeCheck" />

                <ImageView
                    android:id="@+id/Toolcamera"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/camera"
                    app:tint="@color/gray_700"/>
            </LinearLayout>

            <!-- Trade Request Icon -->
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp">

                <ImageView
                    android:id="@+id/tradeRequestIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/handshake2"
                    app:tint="@color/white"/>

                <TextView
                    android:id="@+id/tradeRequestBadge"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="end|top"
                    android:background="@drawable/badge_background"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/colorAccent"
                    android:textSize="15sp"
                    android:visibility="gone"/>
            </FrameLayout>

        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_90dp"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/trendingSliderContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="5dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="4dp"
                    android:orientation="vertical"
                    android:padding="0dp"
                    android:background="@android:color/transparent">

                <!-- Header with Trending Icon -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp"
                    android:paddingHorizontal="4dp">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_trending"
                        app:tint="@color/trending_icon_color" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Trending Now"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/trending_text_color"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔥"
                        android:textSize="16sp" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/trendingViewAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View All"
                        android:textSize="10sp"
                        android:textColor="@color/trending_view_all"
                        android:padding="2dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless" />
                </LinearLayout>

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/trendingViewPager"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:clipToPadding="false"
                    android:layout_marginBottom="8dp"
                    android:paddingHorizontal="0dp" />

            </LinearLayout>

                <!-- Categories Section -->
                <HorizontalScrollView
                    android:id="@+id/categoriesScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:overScrollMode="never">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp">

                        <!-- Electronics -->
                        <LinearLayout
                            android:id="@+id/categoryElectronics"
                            android:layout_width="110dp"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:layout_marginEnd="12dp"
                            android:gravity="center_horizontal">

                            <androidx.cardview.widget.CardView
                                android:layout_width="match_parent"
                                android:layout_height="110dp"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="0dp">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="@string/electronics"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/electronics"/>
                            </androidx.cardview.widget.CardView>

                            <TextView
                                android:id="@+id/tvCategoryElectronics"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/electronics"
                                android:textColor="@color/white"
                                android:textSize="16sp"
                                android:gravity="center"
                                android:ellipsize="end"
                                android:maxLines="1"/>
                        </LinearLayout>

                        <!-- Clothing -->
                        <LinearLayout
                            android:id="@+id/categoryClothing"
                            android:layout_width="110dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginEnd="12dp"
                            android:gravity="center_horizontal">

                            <androidx.cardview.widget.CardView
                                android:layout_width="match_parent"
                                android:layout_height="110dp"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="0dp">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="@string/clothing"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/clothing"/>
                            </androidx.cardview.widget.CardView>

                            <TextView
                                android:id="@+id/tvCategoryClothing"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/clothing"
                                android:textColor="@color/white"
                                android:textSize="16sp"
                                android:gravity="center"
                                android:ellipsize="end"
                                android:maxLines="1"/>
                        </LinearLayout>

                        <!-- Home & Kitchen -->
                        <LinearLayout
                            android:id="@+id/categoryHomeKitchen"
                            android:layout_width="110dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginEnd="12dp"
                            android:gravity="center_horizontal">

                            <androidx.cardview.widget.CardView
                                android:layout_width="match_parent"
                                android:layout_height="110dp"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="0dp">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="@string/home_kitchen"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/appliance"/>
                            </androidx.cardview.widget.CardView>

                            <TextView
                                android:id="@+id/tvCategoryKitchen"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/home_kitchen"
                                android:textColor="@color/white"
                                android:textSize="16sp"
                                android:gravity="center"
                                android:ellipsize="end"
                                android:maxLines="1"/>
                        </LinearLayout>

                        <!-- Books & Education -->
                        <LinearLayout
                            android:id="@+id/categoryBooks"
                            android:layout_width="110dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginEnd="12dp"
                            android:gravity="center_horizontal">

                            <androidx.cardview.widget.CardView
                                android:layout_width="match_parent"
                                android:layout_height="110dp"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="0dp">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="@string/books_educational"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/bookshelf"/>
                            </androidx.cardview.widget.CardView>

                            <TextView
                                android:id="@+id/tvCategoryBooks"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/books_educational"
                                android:textColor="@color/white"
                                android:textSize="16sp"
                                android:gravity="center"
                                android:ellipsize="end"
                                android:maxLines="1"/>
                        </LinearLayout>

                        <!-- Sports -->
                        <LinearLayout
                            android:id="@+id/categorySports"
                            android:layout_width="110dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginEnd="12dp"
                            android:gravity="center_horizontal">

                            <androidx.cardview.widget.CardView
                                android:layout_width="match_parent"
                                android:layout_height="110dp"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="0dp">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="@string/sports_outdoors"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/basketball"/>
                            </androidx.cardview.widget.CardView>

                            <TextView
                                android:id="@+id/tvCategorySportsOutdoor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/sports_outdoors"
                                android:textColor="@color/white"
                                android:textSize="16sp"
                                android:gravity="center"
                                android:ellipsize="end"
                                android:maxLines="1"/>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/viewAllCategories"
                            android:layout_width="110dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:layout_marginEnd="12dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground">


                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="16dp"
                                tools:ignore="UseCompoundDrawables">

                                <ImageView
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:src="@drawable/ic_view_all"
                                    android:contentDescription="@string/view_all_icon"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/view_all"
                                    android:textColor="@color/white"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:layout_marginTop="8dp"
                                    android:gravity="center"/>
                            </LinearLayout>

                        </LinearLayout>
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- 🟠 Filter Button -->
                <LinearLayout
                    android:id="@+id/filterButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:paddingStart="5dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="50dp"
                    android:orientation="horizontal"
                    tools:ignore="TouchTargetSizeCheck">

                    <ImageView
                        android:id="@+id/filterButtonIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/filter"
                        app:tint="@color/white" />

                    <TextView
                        android:id="@+id/filterButtonText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp" />

                    <HorizontalScrollView
                        android:id="@+id/expandedCategoriesScroll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:overScrollMode="never"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/expandedCategoriesContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp" />
                    </HorizontalScrollView>
                </LinearLayout>

                <!-- Featured Items Section -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/featuredItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:visibility="visible"
                    tools:listitem="@layout/item_user_post" />

                <ProgressBar
                    android:id="@+id/featuredProgressBar"
                    style="?android:attr/progressBarStyleLarge"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_gravity="center"
                    android:visibility="gone" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>