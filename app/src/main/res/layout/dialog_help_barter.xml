<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="How to Start a Barter"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="16dp"
            tools:ignore="HardcodedText" />

        <!-- Step-by-Step Process -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/step_by_step_barter_process"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/_1_browse_items_look_for_items_you_re_interested_in_n2_check_pod_values_make_sure_you_have_items_of_similar_value_n3_propose_trade_click_propose_trade_on_the_item_n4_add_your_items_select_what_you_want_to_trade_n5_send_message_explain_why_it_s_a_good_trade_n6_wait_for_response_other_user_accepts_declines_or_counters_n7_arrange_meetup_choose_safe_public_location_n8_complete_trade_exchange_items_and_rate_each_other"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurface"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="16dp" />

        <!-- Tips -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tips"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/start_with_small_value_items_to_build_reputation_n_be_flexible_consider_multi_item_trades_n_communicate_clearly_and_promptly"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurface"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>
</ScrollView>