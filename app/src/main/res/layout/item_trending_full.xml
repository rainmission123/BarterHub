<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:id="@+id/rootLayout"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Image Section with Rounded Corners -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:layout_margin="5dp">

        <!-- Main Item Image with Rounded Corners -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/itemImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher_background"
            app:shapeAppearanceOverlay="@style/RoundedCornerImage"
            tools:ignore="ContentDescription" />

        <!-- Days Posted Badge -->
        <LinearLayout
            android:id="@+id/daysPostedContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="2dp"
            android:background="@drawable/days_posted_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/ic_schedule"
                app:tint="@android:color/white" />

            <TextView
                android:id="@+id/tvDaysPosted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1d ago"
                android:textColor="@android:color/white"
                android:textSize="8sp"
                android:textStyle="bold" />

        </LinearLayout>

    </FrameLayout>

    <!-- DESCRIPTION CARD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="5dp">

        <!-- Title and Like Count Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/itemTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:textColor="@color/white"
                android:lineSpacingExtra="2dp"
                android:maxLines="1"
                android:scrollHorizontally="false"
                android:singleLine="false"
                android:text="Item Title"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Like Count Container -->
            <LinearLayout
                android:id="@+id/likeCountContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:clickable="false"
                android:focusable="false">

                <!-- Like Icon -->
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="2dp"
                    android:contentDescription="@string/todo"
                    android:src="@drawable/ic_like"/>

                <!-- Like Count -->
                <TextView
                    android:id="@+id/tvLikeCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText,SmallSp" />

            </LinearLayout>
        </LinearLayout>

        <!-- Product Description -->
        <TextView
            android:id="@+id/itemDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="none"
            android:maxLines="1"
            android:breakStrategy="simple"
            android:scrollHorizontally="false"
            android:text="Item description here"
            android:textColor="@color/white"
            android:textSize="11sp"
            tools:ignore="HardcodedText" />

        <!-- Condition -->
        <TextView
            android:id="@+id/itemCondition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Condition: "
            android:textColor="@color/white"
            android:textSize="9sp"
            android:textStyle="italic"
            tools:ignore="HardcodedText,SmallSp" />

        <!-- Location Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_location"
                app:tint="@color/gray_400" />

            <TextView
                android:id="@+id/itemLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Location"
                android:textSize="10sp"
                android:textColor="@color/gray_400"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Price Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Price Container -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Price Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/itemPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PHP0.00"
                        android:textColor="@color/red"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                </LinearLayout>

                <!-- Owner Info -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Owner Profile Image -->
                    <ImageView
                        android:id="@+id/itemOwnerImage"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="4dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_profile"
                        tools:ignore="ContentDescription" />

                    <!-- Owner Name -->
                    <TextView
                        android:id="@+id/itemOwner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Posted by: Unknown"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="italic"
                        tools:ignore="SmallSp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Wishlist Icon -->
            <ImageView
                android:id="@+id/itemWishlist"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:clickable="true"
                android:contentDescription="@string/todo"
                android:focusable="true"
                android:scaleType="centerInside"
                android:src="@drawable/ic_heart_selector"
                tools:ignore="TouchTargetSizeCheck,ImageContrastCheck" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>