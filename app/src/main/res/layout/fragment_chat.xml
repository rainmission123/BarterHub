<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- App Bar with Custom Chat Header -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:background="?attr/colorSurface"
        android:layout_height="wrap_content"
        android:elevation="16dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@drawable/bg_home_profile_logo"
            app:menu="@menu/chat_menu"
            app:navigationIcon="@drawable/ic_arrow_back">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                tools:ignore="RtlSymmetry">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/partnerProfileImage"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_person"
                    android:layout_marginEnd="12dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/partnerNameText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chat Partner"
                        android:textColor="@color/White"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:id="@+id/partnerStatusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Online"
                        android:textColor="@color/White"
                        android:textSize="12sp"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.appbar.MaterialToolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="0dp"
        android:background="?attr/colorSurface"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/messagesRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="55dp"
            android:clipToPadding="false"
            android:padding="6dp"
            android:paddingBottom="120dp"
            android:scrollbars="vertical"
            tools:listitem="@layout/message_item" />

        <!-- MESSENGER-STYLE INPUT CONTAINER - FIXED -->
        <LinearLayout
            android:id="@+id/inputContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="0dp">

            <!-- Quick Action Row (optional, can be hidden) -->
            <HorizontalScrollView
                android:id="@+id/quickActionsScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:paddingHorizontal="8dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/likeChip"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:text="👍 Like"
                        app:chipIconSize="16dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/gifChip"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:text="GIF"
                        app:chipIconSize="16dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/stickerChip"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="😊 Sticker"
                        app:chipIconSize="16dp" />

                </LinearLayout>
            </HorizontalScrollView>

            <!-- Main Input Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="12dp"
                android:gravity="center_vertical">

                <!-- Message Input Field -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/messenger_input_bg"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="8dp"
                    android:layout_marginHorizontal="8dp"
                    android:minHeight="44dp">

                    <!-- Attach Button -->
                    <ImageButton
                        android:id="@+id/attachButton"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/attach_file"
                        android:padding="6dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_attach_file"
                        app:tint="@color/gray_600"
                        tools:ignore="TouchTargetSizeCheck" />

                    <!-- Message EditText -->
                    <EditText
                        android:id="@+id/messageEditText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="Message..."
                        android:imeOptions="actionSend"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLines="5"
                        android:minHeight="36dp"
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/gray_800"
                        android:textColorHint="@color/gray_500"
                        android:textSize="16sp"
                        tools:ignore="HardcodedText,TouchTargetSizeCheck" />

                    <!-- Camera Button -->
                    <ImageButton
                        android:id="@+id/cameraButton"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Camera"
                        android:padding="6dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_camera"
                        app:tint="@color/gray_600"
                        tools:ignore="TouchTargetSizeCheck" />

                </LinearLayout>

                <ImageButton
                    android:id="@+id/sendButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_send_button"
                    android:contentDescription="@string/send_message"
                    android:padding="10dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_send"
                    app:tint="@color/white"
                    tools:ignore="TouchTargetSizeCheck" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/scrollToBottomButton"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="bottom|center_horizontal"
            android:background="@drawable/bg_scroll_button"
            android:src="@drawable/ic_arrow_downward"
            android:elevation="6dp"
            android:visibility="visible" />
    </FrameLayout>

    <!-- Typing Indicator -->
    <LinearLayout
        android:id="@+id/typingIndicatorCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="140dp"
        android:background="@drawable/messenger_bubble_received"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/typingAnimation"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/typing_animation" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="typing..."
            android:textColor="@color/on_surface_variant"
            android:textSize="12sp"
            android:textStyle="italic"
            tools:ignore="HardcodedText" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>