<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fitsSystemWindows="true">

    <!-- App Bar with Custom Chat Header -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="4dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:menu="@menu/chat_menu"
            app:navigationIcon="@drawable/ic_arrow_back">

            <!-- CUSTOM CHAT HEADER - This matches the Kotlin code -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                tools:ignore="RtlSymmetry">

                <!-- Partner profile image -->
                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/partnerProfileImage"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_profile_placeholder"
                    android:layout_marginEnd="12dp" />

                <!-- Partner name + status -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/partnerNameText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chat Partner"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:id="@+id/partnerStatusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Online"
                        android:textColor="@color/gray_500"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

        </com.google.android.material.appbar.MaterialToolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Rest of your existing layout remains the same -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="2dp"
        android:layout_marginTop="?attr/actionBarSize"
        android:layout_marginBottom="0dp"
        android:background="@color/surface"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Messages RecyclerView - Takes full space -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/messagesRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="16dp"
            android:paddingBottom="100dp"
            android:scrollbars="vertical"
            tools:listitem="@layout/message_item" />

        <!-- Input Container - FIXED at bottom -->
        <LinearLayout
            android:id="@+id/inputContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/input_top_border"
            android:orientation="horizontal"
            android:padding="8dp"
            android:layout_marginBottom="0dp">

            <!-- Attach Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/attachButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="48dp"
                android:layout_marginBottom="10dp"
                android:layout_height="48dp"
                android:contentDescription="@string/attach_file"
                app:backgroundTint="@color/White"
                app:icon="@drawable/ic_attach_file"
                app:iconGravity="textEnd"
                app:iconSize="24dp"
                app:iconTint="@color/gray_800" />

            <!-- Message Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/messageInputLayout"
                style="@style/Widget.Material3.TextInputLayout.FilledBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                app:boxBackgroundColor="@color/White"
                app:boxBackgroundMode="filled"
                app:boxCornerRadiusBottomEnd="20dp"
                app:boxCornerRadiusBottomStart="20dp"
                app:boxCornerRadiusTopEnd="20dp"
                app:boxCornerRadiusTopStart="20dp"
                app:endIconMode="clear_text"
                app:endIconTint="@color/primaryDarkColor"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/messageEditText"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Type a message..."
                    android:maxLines="3"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/colorAccent"
                    android:textSize="14sp"
                    tools:ignore="HardcodedText" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Send Button - CHANGED to MaterialButton to match Kotlin -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/sendButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/send_message"
                app:backgroundTint="@color/colorAccent"
                app:icon="@drawable/ic_send"
                app:iconTint="@color/white"
                tools:ignore="TouchTargetSizeCheck" />

        </LinearLayout>

    </FrameLayout>

    <!-- Typing Indicator -->
    <LinearLayout
        android:id="@+id/typingIndicatorCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="120dp"
        android:background="@color/surface_container"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/typingAnimation"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/typing_animation" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="typing..."
            android:textColor="@color/on_surface_variant"
            android:textSize="12sp"
            android:textStyle="italic"
            tools:ignore="HardcodedText" />

    </LinearLayout>

    <!-- REMOVED Duplicate Online Status Badge -->

</androidx.coordinatorlayout.widget.CoordinatorLayout>