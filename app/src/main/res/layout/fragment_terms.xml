<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Terms of Service"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="8dp"
            tools:ignore="HardcodedText" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/last_updated_november_2025"
            android:textSize="14sp"
            android:textColor="@color/gray_600"
            android:layout_marginBottom="24dp" />

        <!-- Introduction -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/welcome_to_barterhub_ph_by_using_our_app_you_agree_to_these_terms_of_service_please_read_them_carefully"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurface"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="24dp" />

        <!-- Section 1: Acceptance of Terms -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/_1_acceptance_of_terms"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/by_accessing_or_using_barterhub_ph_you_agree_to_be_bound_by_these_terms_if_you_disagree_with_any_part_you_may_not_use_our_services"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurface"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="24dp" />

        <!-- Section 2: User Responsibilities -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/_2_user_responsibilities"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/be_honest_about_item_conditions_and_descriptions_n_communicate_respectfully_with_other_users_n_meet_in_safe_public_locations_for_trades_n_only_trade_items_you_legally_own_n_accurately_represent_your_items_with_clear_photos_n_respond_to_trade_requests_in_a_timely_manner"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurface"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="24dp" />

        <!-- Section 3: Prohibited Items & Activities -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/_3_prohibited_items_amp_activities"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/you_may_not_trade_n_weapons_firearms_or_ammunition_n_illegal_substances_or_drugs_n_stolen_or_counterfeit_goods_n_adult_content_or_explicit_material_n_live_animals_or_endangered_species_n_hazardous_materials_n_human_remains_or_body_parts_n_government_documents_or_ids"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurface"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="24dp" />

        <!-- Section 4: Pod System -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/_4_pod_system_amp_trading"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pods_are_virtual_trade_units_not_real_currency_n_you_assign_pod_values_to_your_items_responsibly_n_trades_should_be_fair_and_mutually_agreed_upon_n_barterhub_is_not_responsible_for_trade_disputes_n_users_are_encouraged_to_rate_trading_partners_fairly"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurface"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="24dp" />

        <!-- Section 5: Safety Guidelines -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/_5_safety_guidelines"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/always_meet_in_well_lit_public_places_n_bring_a_friend_if_possible_especially_for_valuable_trades_n_meet_during_daylight_hours_when_possible_n_inform_someone_about_your_meetup_plans_n_trust_your_instincts_if_something_feels_wrong_cancel_n_verify_item_condition_before_completing_trade"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurface"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="24dp" />

        <!-- Section 6: Account & Conduct -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/_6_account_amp_conduct"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/you_must_be_at_least_18_years_old_to_use_barterhub_n_one_account_per_person_no_multiple_accounts_n_no_harassment_hate_speech_or_abusive_behavior_n_respect_other_users_privacy_and_personal_information_n_no_spamming_or_unsolicited_commercial_messages_n_maintain_accurate_and_up_to_date_profile_information"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurface"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="24dp" />

        <!-- Section 7: Intellectual Property -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/_7_intellectual_property"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/barterhub_ph_owns_all_intellectual_property_related_to_the_app_n_you_retain_ownership_of_your_content_photos_descriptions_n_by_posting_content_you_grant_barterhub_license_to_display_it_n_do_not_post_copyrighted_material_without_permission"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurface"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="24dp" />

        <!-- Section 8: Limitation of Liability -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/_8_limitation_of_liability"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/barterhub_ph_is_a_platform_connecting_traders_we_are_not_party_to_any_trades_and_are_not_responsible_for_n_trade_disputes_between_users_n_item_quality_or_condition_n_user_conduct_during_meetups_n_any_losses_or_damages_resulting_from_trades_n_user_safety_during_in_person_meetings"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurface"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="24dp" />

        <!-- Section 9: Termination -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/_9_account_termination"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/we_may_suspend_or_terminate_accounts_for_n_violation_of_these_terms_of_service_n_fraudulent_or_deceptive_practices_n_harassment_of_other_users_n_multiple_justified_complaints_n_illegal_activities_n_creating_multiple_accounts"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurface"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="24dp" />

        <!-- Section 10: Changes to Terms -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/_10_changes_to_terms"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/we_may_update_these_terms_periodically_continued_use_of_barterhub_after_changes_constitutes_acceptance_of_the_new_terms_we_will_notify_users_of_significant_changes"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurface"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="24dp" />

        <!-- Section 11: Contact -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/_11_contact_information"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/for_questions_about_these_terms_or_to_report_violations_n_nemail_barterhubph_team_gmail_com_n_nwe_typically_respond_within_2_3_business_days"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurface"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="24dp" />

        <!-- Agreement Section -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/agreement"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/by_using_barterhub_ph_you_acknowledge_that_you_have_read_understood_and_agree_to_be_bound_by_these_terms_of_service"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurface"
                    android:lineSpacingExtra="4dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>