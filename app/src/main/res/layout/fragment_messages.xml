<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="?attr/colorSurface"
    android:paddingBottom="125dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/messagesRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="160dp"
        android:paddingBottom="16dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="visible"
        android:paddingTop="160dp">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:contentDescription="@string/no_messages"
            android:src="@drawable/ic_message_empty"
            app:tint="@color/gray_500"
            tools:ignore="ImageContrastCheck" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/no_messages_yet"
            android:textColor="#0097A7"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/start_a_conversation_with_other_users"
            android:textColor="#546E7A"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Fixed Top Area: Search + Chips -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Search Bar -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/searchCard"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@color/background_light"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@string/todo"
                    android:src="@drawable/ic_search"
                    app:tint="@color/gray_600" />

                <EditText
                    android:id="@+id/searchEditText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/search_messages"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:minHeight="48dp"
                    android:textColor="@android:color/black"
                    android:textColorHint="#546E7A"
                    android:textSize="14sp"
                    tools:ignore="VisualLintTextFieldSize,TouchTargetSizeCheck" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Chips -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/allChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:text="@string/all"
                app:chipBackgroundColor="@color/background"
                app:chipStrokeColor="@color/colorAccent"
                app:chipStrokeWidth="1dp"
                app:checkedIcon="@null" />

            <com.google.android.material.chip.Chip
                android:id="@+id/unreadChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/unread"
                android:textColor="@color/black"
                app:chipBackgroundColor="@color/background"
                app:chipStrokeColor="@color/colorAccent"
                app:chipStrokeWidth="1dp"
                app:checkedIcon="@null" />

            <com.google.android.material.chip.Chip
                android:id="@+id/archivedChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:text="@string/archived"
                app:chipBackgroundColor="@color/background"
                app:chipStrokeColor="@color/colorAccent"
                app:chipStrokeWidth="1dp"
                app:checkedIcon="@null" />
        </com.google.android.material.chip.ChipGroup>

        <!-- ✅ Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/botFabContainer"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="6dp"
        android:clickable="true"
        android:focusable="true">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/fabLottie"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:lottie_rawRes="@raw/chat_bot"
            app:lottie_autoPlay="true"
            app:lottie_loop="true" />
    </FrameLayout>

</FrameLayout>
