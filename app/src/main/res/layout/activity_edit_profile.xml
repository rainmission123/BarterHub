<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="6dp"
    android:background="@drawable/login_background"
    tools:context=".ui.EditProfileActivity">

    <LinearLayout
        android:layout_marginBottom="@dimen/_90dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Profile-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Profile Image -->
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/ivProfileImage"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@drawable/ic_profile_placeholder"
                    app:civ_border_width="1dp" />

                <!-- Change Photo Button -->
                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/fabChangePhoto"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignEnd="@id/ivProfileImage"
                    android:layout_alignBottom="@id/ivProfileImage"
                    android:contentDescription="@string/change_photo"
                    android:src="@drawable/ic_camera"
                    app:backgroundTint="@color/gray_500"
                    app:fabSize="mini"
                    app:tint="@color/white" />

            </RelativeLayout>

            <!-- Change Photo Text -->
            <TextView
                android:id="@+id/changePhotoText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/change_photo"
                android:textColor="@color/gray_500"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Profile Information Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/colorAccent"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Card Title -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="@string/profile_information"
                    android:textColor="@color/gray_600"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Full Name -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.FilledBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="@string/full_name"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxBackgroundColor="@color/gray_200"
                    app:boxCornerRadiusTopStart="12dp"
                    app:startIconDrawable="@drawable/ic_person"
                    app:startIconTint="@color/gray_500">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editFullName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName|textCapWords"
                        android:minHeight="52dp"
                        android:paddingStart="40dp"
                        android:textColor="@color/gray_700"
                        android:textColorHint="@color/gray_900"
                        tools:ignore="RtlSymmetry" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Bio -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.FilledBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="@string/bio"
                    app:boxBackgroundColor="@color/gray_200"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    android:textColorHint="@color/gray_600"
                    app:counterEnabled="true"
                    app:counterMaxLength="150"
                    app:startIconDrawable="@drawable/ic_info"
                    app:startIconTint="@color/gray_600">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editBio"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:gravity="top"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLength="150"
                        android:maxLines="5"
                        android:minLines="3"
                        android:textColor="@color/gray_700"
                        android:textColorHint="@color/gray_900"
                        android:paddingStart="@dimen/_40dp"
                        tools:ignore="RtlSymmetry" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp"
                    android:gravity="center_vertical">

                    <!-- Static +63 -->
                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="52dp"
                        android:gravity="center"
                        android:text="+63"
                        android:textColor="@color/gray_700"
                        android:textSize="16sp"
                        android:background="@color/gray_200" />

                    <!-- Phone Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.FilledBox"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:hint="@string/phone"
                        app:boxBackgroundColor="@color/gray_200"
                        app:boxStrokeWidth="0dp"
                        app:hintEnabled="true">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editphone"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:inputType="phone"
                            android:paddingStart="8dp"
                            android:textColor="@color/gray_700"
                            android:textColorHint="@color/gray_900"
                            tools:ignore="RtlSymmetry" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>


                <!-- Location -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.FilledBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:hint="@string/location"
                    app:boxBackgroundColor="@color/gray_200"
                    app:boxCornerRadiusBottomEnd="12dp"
                    android:textColorHint="@color/gray_600"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:startIconDrawable="@drawable/ic_location"
                    app:startIconTint="@color/gray_600">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:minHeight="52dp"
                        android:textColor="@color/gray_700"
                        android:textColorHint="@color/gray_900"
                        android:paddingStart="40dp"
                        tools:ignore="RtlSymmetry" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Save / Cancel Buttons -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/colorAccent"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Save Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSave"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:text="@string/save_profile"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:textColor="@color/colorAccent"
                    app:strokeColor="@color/colorAccent"
                    app:backgroundTint="@color/background_light"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_check"
                    app:iconGravity="end"
                    app:iconPadding="4dp"
                    app:iconTint="@color/white" />

                <!-- Cancel Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancel"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/cancel"
                    android:textAllCaps="false"
                    android:textColor="@color/colorAccent"
                    app:backgroundTint="@color/background_light"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/colorAccent"
                    app:strokeWidth="1dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
