<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp"
    android:background="?attr/colorSurface"
    tools:context=".ui.EditProfileActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Profile Image Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="24dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginBottom="12dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/ivProfileImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_profile_placeholder"
                    android:scaleType="centerCrop"
                    android:elevation="4dp"
                    app:civ_border_width="1dp"
                    app:civ_border_color="@color/gray_300" />

                <!-- IMPORTANT: use fabCustomSize para sure ang size -->
                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/fabChangePhoto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="-6dp"
                    android:layout_marginBottom="-6dp"
                    android:contentDescription="@string/todo"
                    app:fabCustomSize="40dp"
                    app:maxImageSize="20dp"
                    app:srcCompat="@drawable/profilecamera"
                    app:backgroundTint="@color/bh_accent"
                    app:tint="@android:color/white"
                    android:elevation="6dp" />

            </FrameLayout>

            <TextView
                android:id="@+id/changePhotoText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/change_photo"
                android:textColor="@color/gray_500"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Modern Profile Info Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="32dp"
            android:background="@drawable/shape_card_modern"
            android:clipToPadding="false"
            android:elevation="8dp"
            android:outlineAmbientShadowColor="@color/surface_shadow"
            android:outlineSpotShadowColor="@color/surface_shadow"
            android:padding="0dp"
            tools:targetApi="28">

            <!-- Card Header with Gradient -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="16dp">

                <!-- Title with Icon -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_information"
                        android:textSize="20sp"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:letterSpacing="0.02" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/update_your_personal_details"
                    android:textSize="14sp"
                    android:textColor="@color/white_alpha_80"
                    android:letterSpacing="0.01" />
            </LinearLayout>

            <!-- Form Content -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_form_container"
                android:paddingHorizontal="20dp"
                android:paddingTop="24dp"
                android:paddingBottom="20dp">

                <!-- Full Name -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/full_name"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="?attr/colorOutline"
                        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp">

                            <!-- Icon -->
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_person"
                                android:contentDescription="@null"
                                app:tint="@color/gray_500" />

                            <!-- Divider -->
                            <View
                                android:layout_width="1dp"
                                android:layout_height="24dp"
                                android:layout_marginStart="10dp"
                                android:layout_marginEnd="12dp"
                                android:background="?attr/colorOutlineVariant" />

                            <!-- Full Name Input -->
                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/fullNameContainer"
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                app:boxBackgroundMode="none"
                                app:hintEnabled="false"
                                app:startIconDrawable="@null"
                                app:endIconMode="none"
                                app:errorIconTint="@color/error_500">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/editFullName"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@android:color/transparent"
                                    android:hint="@string/full_name"
                                    android:inputType="textPersonName|textCapWords"
                                    android:padding="0dp"
                                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textColorHint="?attr/colorOnSurfaceVariant"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- Bio -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bio"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="?attr/colorOutline"
                        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingTop="14dp"
                            android:paddingBottom="14dp">

                            <!-- Icon -->
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_edit"
                                android:layout_marginTop="20dp"
                                android:contentDescription="@null"
                                app:tint="@color/gray_500" />

                            <!-- Divider -->
                            <View
                                android:layout_width="1dp"
                                android:layout_height="60dp"
                                android:layout_marginStart="10dp"
                                android:layout_marginEnd="12dp"
                                android:background="?attr/colorOutlineVariant" />

                            <!-- Bio Input -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/bioContainer"
                                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    app:boxBackgroundMode="none"
                                    app:hintEnabled="false"
                                    app:startIconDrawable="@null"
                                    app:endIconMode="none"
                                    app:counterEnabled="true"
                                    app:counterMaxLength="160"
                                    app:counterTextColor="?attr/colorOnSurfaceVariant">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/editBio"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:background="@android:color/transparent"
                                        android:hint="@string/bio"
                                        android:inputType="textMultiLine|textCapSentences"
                                        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                                        android:textColor="?attr/colorOnSurface"
                                        android:textColorHint="?attr/colorOnSurfaceVariant"
                                        android:maxLength="160"
                                        android:maxLines="4"
                                        android:scrollbars="vertical" />

                                </com.google.android.material.textfield.TextInputLayout>

                            </LinearLayout>

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- Phone Number -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Phone Number"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="?attr/colorOutline"
                        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="10dp"
                            android:paddingEnd="12dp">

                            <!-- Country Code -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/countryCodePicker"
                                android:layout_width="72dp"
                                android:layout_height="40dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardCornerRadius="10dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="1dp"
                                app:strokeColor="?attr/colorOutlineVariant"
                                app:cardBackgroundColor="@color/transparent_05">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="+63"
                                        android:textSize="15sp"
                                        android:textStyle="bold"
                                        android:textColor="?attr/colorOnSurface" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Divider -->
                            <View
                                android:layout_width="1dp"
                                android:layout_height="24dp"
                                android:layout_marginStart="10dp"
                                android:layout_marginEnd="10dp"
                                android:background="?attr/colorOutlineVariant" />

                            <!-- Phone Input -->
                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/phoneContainer"
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                app:boxBackgroundMode="none"
                                app:hintEnabled="false"
                                app:startIconDrawable="@null"
                                app:endIconMode="none">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/editPhone"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@android:color/transparent"
                                    android:hint="9123456789"
                                    android:inputType="number"
                                    android:maxLength="10"
                                    android:digits="0123456789"
                                    android:padding="0dp"
                                    android:textSize="16sp"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textColorHint="?attr/colorOnSurfaceVariant"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>


                <!-- Location -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/location"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="?attr/colorOutline"
                        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp">

                            <!-- Icon -->
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_location"
                                android:contentDescription="@null"
                                app:tint="@color/red" />

                            <!-- Divider -->
                            <View
                                android:layout_width="1dp"
                                android:layout_height="24dp"
                                android:layout_marginStart="10dp"
                                android:layout_marginEnd="12dp"
                                android:background="?attr/colorOutlineVariant" />

                            <!-- Location Input -->
                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/locationContainer"
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                app:boxBackgroundMode="none"
                                app:hintEnabled="false"
                                app:startIconDrawable="@null"
                                app:endIconMode="none">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/editLocation"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@android:color/transparent"
                                    android:hint="@string/location"
                                    android:imeOptions="actionDone"
                                    android:inputType="textCapWords"
                                    android:maxLines="1"
                                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textColorHint="?attr/colorOnSurfaceVariant" />

                            </com.google.android.material.textfield.TextInputLayout>

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/save_profile"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textColor="@color/white"
                app:backgroundTint="@color/bh_accent"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_check"
                app:iconGravity="end"
                app:iconPadding="4dp"
                app:iconTint="@color/white" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
