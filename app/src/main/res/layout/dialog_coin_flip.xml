<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/popup_rounded_bg"
    android:gravity="center_horizontal">

    <!-- Header with Close Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Coin Flip"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center"
            tools:ignore="HardcodedText" />

        <ImageView
            android:id="@+id/btnCloseCoinFlip"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/todo"
            android:src="@drawable/ic_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            app:tint="@color/gray_600" />

    </LinearLayout>

    <!-- Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Heads or Tails? Double your coins!"
        android:textSize="14sp"
        android:textColor="@color/gray_600"
        android:layout_marginTop="4dp"
        android:gravity="center"
        tools:ignore="HardcodedText" />


        <ImageView
            android:id="@+id/imgCoin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/coin_heads"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:layout_gravity="bottom"/>


    <!-- Betting Options -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:gravity="center">

        <!-- Heads Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHeads"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="HEADS"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:strokeColor="@color/red_500"
            android:textColor="@color/red_500"
            android:paddingVertical="12dp"
            app:cornerRadius="12dp"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Tails Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTails"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="TAILS"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:strokeColor="@color/blue_500"
            android:textColor="@color/blue_500"
            android:paddingVertical="12dp"
            app:cornerRadius="12dp"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Result Display -->
    <TextView
        android:id="@+id/tvCoinResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/choose_heads_or_tails_then_flip"
        android:textSize="16sp"
        android:textColor="@color/gray_700"
        android:gravity="center"
        android:layout_marginTop="20dp"
        android:padding="16dp"
        android:background="@drawable/result_bg" />

    <!-- Flip Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFlipCoin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/flip_coin"
        android:textStyle="bold"
        android:textSize="15sp"
        android:letterSpacing="0.02"
        android:paddingVertical="16dp"
        app:cornerRadius="14dp"
        android:backgroundTint="@color/premium_gold"
        android:textColor="@color/black"
        android:layout_marginTop="16dp"
        app:icon="@drawable/ic_refresh"
        app:iconGravity="textStart"
        app:iconPadding="8dp" />

    <!-- Cost and Prize Info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:gravity="center">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_barter_coins"
                android:layout_marginEnd="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cost_5_coins"
                android:textSize="12sp"
                android:textColor="@color/gray_600" />

        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="12dp"
            android:background="@color/White"
            android:layout_marginHorizontal="8dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_trophy"
                android:layout_marginEnd="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/win_10_coins"
                android:textSize="12sp"
                android:textColor="@color/gray_600" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
