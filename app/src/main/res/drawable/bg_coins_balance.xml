<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Background -->
    <solid android:color="?attr/colorSurfaceVariant" />

    <!-- Border -->
    <stroke
        android:width="1dp"
        android:color="@color/premium_gold" />

    <!-- Radius -->
    <corners android:radius="14dp" />

    <!-- Padding -->
    <padding
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp" />

</shape>