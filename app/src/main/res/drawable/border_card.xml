<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Solid background -->
    <solid android:color="@color/surface" />

    <!-- Border (stroke) -->
    <stroke
        android:width="1dp"
        android:color="@color/outline" />

    <!-- Rounded corners -->
    <corners android:radius="12dp" />

    <!-- Padding para hindi masyadong dikit ang content sa border -->
    <padding
        android:left="20dp"
        android:top="24dp"
        android:right="20dp"
        android:bottom="20dp" />
</shape>