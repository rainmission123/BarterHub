<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Gradient background -->
    <gradient
        android:type="linear"
        android:angle="270"
        android:startColor="#9C27B0"
        android:centerColor="#7B1FA2"
        android:endColor="#2A003F" />

    <!-- Premium stroke (glass + purple blend) -->
    <stroke
        android:width="1dp"
        android:color="#FFFFFF" />

    <!-- Rounded corners -->
    <corners android:radius="16dp" />

    <!-- Padding -->
    <padding
        android:left="20dp"
        android:top="24dp"
        android:right="20dp"
        android:bottom="20dp" />

</shape>