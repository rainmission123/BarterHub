<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">

    <!-- Gradient -->
    <gradient
        android:startColor="#9C27B0"
        android:endColor="#6A1B9A"
        android:angle="270"/>

    <!-- Soft shadow feel -->
    <padding
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp"/>

    <!-- Border glow -->
    <stroke
        android:width="1dp"
        android:color="#33FFFFFF"/>

</shape>