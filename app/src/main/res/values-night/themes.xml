<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark Theme - SUPER SIMPLIFIED -->
    <style name="Base.Theme.BarterHub" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Custom colors for posts -->
        <item name="postTextColor">@color/text_primary_dark</item>
        <item name="postTextColorSecondary">@color/text_secondary_dark</item>
        <item name="postPriceColor">@color/error_light</item>
        <item name="postWishlistIconColor">@color/white</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Navigation bar -->
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>

        <!-- Material 3 Color Tokens - SIMPLIFIED -->
        <item name="colorPrimary">@color/colorAccent</item>
        <item name="colorOnPrimary">@color/black</item>

        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Surface colors - SIMPLIFIED -->
        <item name="colorSurface">@color/soft_dark_surface</item>
        <item name="colorOnSurface">@color/soft_dark_text</item>
        <item name="colorSurfaceVariant">@color/soft_dark_background</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_dark</item>

        <!-- Error colors -->
        <item name="colorError">@color/error_light</item>
        <item name="colorOnError">@color/black</item>
    </style>

    <style name="Theme.BarterHub" parent="Base.Theme.BarterHub" />
</resources>