<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Para sa development at testing -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <!-- Para sa production - mas secure na version -->
    <!-- <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config> -->

    <!-- O kaya specific domain configuration -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">192.168.1.1</domain> <!-- Adjust to your local IP -->
    </domain-config>

    <!-- Para sa Firebase services -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">barterhub-3c947.firebaseio.com</domain>
        <domain includeSubdomains="true">barterhub-3c947.firebasestorage.app</domain>
        <domain includeSubdomains="true">barterhub-3c947.appspot.com</domain>
        <domain includeSubdomains="true">firestore.googleapis.com</domain>
        <domain includeSubdomains="true">firebasestorage.googleapis.com</domain>
    </domain-config>

    <!-- Para sa social logins -->
    <domain-config>
        <domain includeSubdomains="true">facebook.com</domain>
        <domain includeSubdomains="true">www.facebook.com</domain>
        <domain includeSubdomains="true">google.com</domain>
        <domain includeSubdomains="true">accounts.google.com</domain>
        <domain includeSubdomains="true">www.googleapis.com</domain>
    </domain-config>
</network-security-config>